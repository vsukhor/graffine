OUTPUT_DIRECTORY = @CMAKE_CURRENT_SOURCE_DIR@/doxygen/
INPUT            = @PROJECT_SOURCE_DIR@/include/
INPUT           += @PROJECT_SOURCE_DIR@/README.md
IMAGE_PATH       = @CMAKE_CURRENT_SOURCE_DIR@/imgs/
FILTER_PATTERNS  = "*README.md=sed -f @CMAKE_CURRENT_SOURCE_DIR@/readme_filter.sed"
USE_MDFILE_AS_MAINPAGE = @PROJECT_SOURCE_DIR@/README.md
RECURSIVE        = YES
PROJECT_NAME     = "@CMAKE_PROJECT_NAME@"
PROJECT_NUMBER   = @CMAKE_PROJECT_VERSION@
FILE_PATTERNS    = *.h
EXCLUDE_PATTERNS = _*.h
WARN_IF_UNDOCUMENTED = NO
GENERATE_XML = YES
JAVADOC_AUTOBRIEF = YES
OUTPUT_LANGUAGE  = English
