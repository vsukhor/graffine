/**
 * \file config_cmake.h
 * \brief Project metadata and compile-time configuration flags set by CMake.
 * \details CMake generates config_cmake.h from config_cmake.h.in when the
 * project is configured, substituting the values of the project metadata
 * and of the GRAFFINE_* cache variables.
 * \author Valerii Sukhorukov <vsukhorukov@yahoo.com>
 */

#ifndef GRAFFINE_CONFIG_CMAKE_H
#define GRAFFINE_CONFIG_CMAKE_H

#include <string_view>

// WARNING: Do not modify config_cmake.h directly: it is regenerated
// at each configuration. Modify config_cmake.h.in instead.

namespace graffine {

inline constexpr auto projectName = std::string_view("@PROJECT_NAME@");  ///< Project name.
inline constexpr auto projectDescription = std::string_view("@PROJECT_DESCRIPTION@");  ///< One-line project description.
inline constexpr auto projectVer = std::string_view("@PROJECT_VERSION@");  ///< Full version, as "major.minor.patch".
inline constexpr auto projectVerMajor = std::string_view("@PROJECT_VERSION_MAJOR@");  ///< Major version number.
inline constexpr auto projectVerMinor = std::string_view("@PROJECT_VERSION_MINOR@");  ///< Minor version number.
inline constexpr auto projectVerPatch = std::string_view("@PROJECT_VERSION_PATCH@");  ///< Patch version number.

/// Transformation functors report their steps verbosely (GRAFFINE_FUNCTORS_VERBOSE).
inline constexpr bool verboseF {std::string_view("@GRAFFINE_FUNCTORS_VERBOSE@") == std::string_view("ON")};
/// Printouts include detailed information on edges (GRAFFINE_PRINT_EDGES).
inline constexpr bool printEdges {std::string_view("@GRAFFINE_PRINT_EDGES@") == std::string_view("ON")};
/// Printouts include detailed information on vertices (GRAFFINE_PRINT_VERTICES).
inline constexpr bool printVertices {std::string_view("@GRAFFINE_PRINT_VERTICES@") == std::string_view("ON")};
/// Graph integrity checks are enabled (GRAFFINE_DO_INTEGRAL_TESTS).
inline constexpr bool doIntegralTests {std::string_view("@GRAFFINE_DO_INTEGRAL_TESTS@") == std::string_view("ON")};

/// Real numbers are \c double rather than \c float (GRAFFINE_REAL_IS_DOUBLE).
inline constexpr bool realIsDouble {std::string_view("@GRAFFINE_REAL_IS_DOUBLE@") == std::string_view("ON")};

}  // namespace graffine

#endif // GRAFFINE_CONFIG_CMAKE_H